# ==============================================================================
# app.env — environnement de production du service de streaming. MODÈLE : ne
# jamais commiter le fichier rempli, ni y laisser une vraie valeur ici.
#
# Sur le VPS : /opt/eenv-stream/app.env, propriété de `deploy`, mode 600.
# Une copie CHIFFRÉE du fichier rempli vit dans le dépôt `context`.
#
# Ce fichier est lu par QUATRE conteneurs : les deux serveurs, les deux workers —
# et par le conteneur `buckets` (mc), d'où la présence des variables RustFS.
# ==============================================================================

TZ=UTC
NODE_ENV=production
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
APP_KEY=

APP_URL=https://stream.eenv.brainsial.com

# --- PostgreSQL ---------------------------------------------------------------
# Base DISTINCTE de celle du portail : les deux services ne partagent aucun
# schéma, seulement Redis et le domaine public.
DB_HOST=postgres
DB_PORT=5432
DB_USER=eenv_streaming
DB_PASSWORD=
DB_DATABASE=eenv_streaming

# --- Redis --------------------------------------------------------------------
# Espace 1 : `gad-portail` occupe le 0. DOIT être identique au REDIS_DB du
# portail — les deux services se lisent les mêmes clés de progression.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Nombre de transcodages simultanés par worker. ffmpeg avec trois rendus est
# gourmand en CPU ; la file est là pour absorber la charge, pas pour saturer la
# machine. À monter seulement après avoir observé la charge réelle.
WORKER_CONCURRENCY=2

# --- Vérification déléguée du jeton (ADR-0003) --------------------------------
# Ce service ne connaît aucun utilisateur : il renvoie le jeton reçu au portail,
# qui dit oui ou non. Par le DOMAINE PUBLIC et non par un nom de conteneur —
# celui-ci change à chaque bascule du portail (`eenv-portal-blue` / `-green`).
AUTH_VERIFY_URL=https://eenv.brainsial.com/streaming/verify
AUTH_VERIFY_METHOD=GET
AUTH_VERIFY_STATUS=200

# --- RustFS (S3-compatible) ---------------------------------------------------
# Adresse INTERNE : contrairement au portail, ce service téléverse lui-même ses
# fichiers — aucun navigateur ne signe ni ne reçoit ces URL. Le réseau
# `rustfs_default` rend le nom du conteneur résoluble.
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Bucket PROPRE à ce service : il n'a aucun accès à celui du portail, dont il ne
# reçoit qu'une URL de lecture qui expire (ADR-0033, « chacun son magasin »).
RUSTFS_BUCKET=eenv-streaming

# --- URL publique du HLS (ADR-0006) -------------------------------------------
# ⚠️ ÉCRITE EN DUR EN BASE dans chaque enseignement transcodé
# (`<HLS_PUBLIC_BASE_URL>/hls/<id>/master.m3u8`). La changer casse TOUS les
# audios déjà publiés et impose une migration. C'est la porte d'entrée (Caddy),
# jamais l'adresse interne de RustFS.
HLS_PUBLIC_BASE_URL=https://stream.eenv.brainsial.com
