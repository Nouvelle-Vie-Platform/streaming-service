# Deployment config for docker-compose. Copy to .env.docker and fill in, then:
#   docker compose --env-file .env.docker up -d --build
#
# Using a dedicated file (not the app's dev .env) keeps host-local dev values
# from leaking into the containers.

# Required
APP_KEY=
AUTH_VERIFY_URL=https://your-verifier.example.com/verify

# External Postgres — host defaults to the Docker host
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=streaming
DB_PASSWORD=streaming
DB_DATABASE=streaming_service

# External Redis
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
# Logical Redis database index (default 0). On a Redis shared with other projects this is
# what keeps key spaces apart. MUST match the portal's REDIS_DB.
REDIS_DB=0

# External RustFS (S3-compatible)
RUSTFS_ENDPOINT=http://host.docker.internal:9000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=streaming-service

# Tuning
WORKER_CONCURRENCY=2
# AUTH_VERIFY_METHOD=GET
# AUTH_VERIFY_STATUS=200

# Public base URL where Caddy/CDN serves the HLS (ADR-0006)
HLS_PUBLIC_BASE_URL=https://media.example.com
