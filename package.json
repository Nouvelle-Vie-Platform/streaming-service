{
  "name": "streaming-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "worker": "node ace transcode:work",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#core/*": "./app/core/*.js",
    "#common/*": "./app/common/*.js",
    "#transcodes/*": "./app/transcodes/*.js",
    "#mails/*": "./app/mails/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.4",
    "@types/node": "^25.9.5",
    "eslint": "^10.8.1",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@adonisjs/core": "^7.3.5",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/transmit": "^3.0.1",
    "@aws-sdk/client-s3": "^3.1108.0",
    "@boringnode/bus": "^0.9.1",
    "@vinejs/vine": "^4.4.0",
    "bullmq": "^6.1.0",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "uuid": "^14.0.1"
  },
  "bundleDependencies": [
    "@adonisjs/core",
    "reflect-metadata"
  ],
  "overrides": {
    "@boringnode/bus": {
      "ioredis": "$ioredis"
    },
    "jsonschema": "1.4.1"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/app"
  },
  "prettier": "@adonisjs/prettier-config"
}
