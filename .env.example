TZ=UTC
PORT=3333
HOST=localhost
APP_URL=http://${HOST}:${PORT}
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=streaming_service

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Logical Redis database index (default 0). On a Redis shared with other projects this is
# what keeps key spaces apart. MUST match the portal's REDIS_DB.
REDIS_DB=0
WORKER_CONCURRENCY=2

AUTH_VERIFY_URL=https://auth.example.com/verify
AUTH_VERIFY_METHOD=GET
AUTH_VERIFY_STATUS=200
# AUTH_VERIFY_BODY_MATCH=
# AUTH_CACHE_TTL=60

RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=streaming-service

# Public base URL where Caddy/CDN serves the HLS (ADR-0006)
HLS_PUBLIC_BASE_URL=http://localhost:8080
